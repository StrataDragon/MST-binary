# Copy this file to `.env` and fill it in. `.env` is git-ignored. NEVER commit real keys.
# Use throw-away TESTNET wallets only.

# ---- MST testnet (values verified from MST-published repos; re-check before deploying) ----
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com
# Optional: force a gas price in gwei if the RPC's automatic price fails
# MST_GAS_PRICE_GWEI=

# ---- Local node overrides ----
LOCAL_RPC_URL=http://127.0.0.1:8545

# ---- Deployer / customer wallet (needs tMSTC from https://faucet.mstblockchain.com/) ----
MST_PRIVATE_KEY=

# ---- Verifier (Member 3's verifier service key). Only its ADDRESS is needed to deploy. ----
VERIFIER_ADDRESS=
# Only needed by scripts/seed-demo.ts / demo-e2e.ts to sign attestations locally:
VERIFIER_PRIVATE_KEY=

# ---- Demo machine M-042 (Member 3's machine agent wallet) ----
MACHINE_ID=M-042
MACHINE_PRIVATE_KEY=
# Optional: separate payout wallet / signer (default: both = machine wallet)
# MACHINE_WALLET_ADDRESS=
# MACHINE_SIGNER_ADDRESS=

# ---- Demo parameters ----
MIN_STAKE=0
MACHINE_STAKE=0.01
JOB_REWARD=100
JOB_DURATION_SECONDS=3600
DEMO_JOB_DESCRIPTION=Move package A to green zone
LOCAL_MACHINE_FUND_ETH=10
LOCAL_VERIFIER_FUND_ETH=10
