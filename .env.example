# Copy this file to `.env` and fill it in. `.env` is git-ignored. NEVER commit real keys.
# Use throw-away TESTNET wallets only.

# ---- MST testnet (values verified from MST-published repos; re-check before deploying) ----
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com
# Optional: force a gas price in gwei if the RPC's automatic price fails
# MST_GAS_PRICE_GWEI=

# ---- Local node overrides ----
LOCAL_RPC_URL=http://127.0.0.1:8545

# ---- Deployer / customer wallet (needs tMSTC from faucet https://faucet.masterstroke.academy) ----
MST_PRIVATE_KEY=

# ---- Contract Address Overrides (optional: defaults to deployments/mst-testnet.json) ----
MACHINE_REGISTRY_ADDRESS=
JOB_ESCROW_ADDRESS=

# ---- Verifier (Member 3's verifier service key). Only its ADDRESS is needed to deploy. ----
VERIFIER_ADDRESS=
# Only needed by backend/verifier service to sign attestations:
VERIFIER_PRIVATE_KEY=

# ---- Demo machine 1: M-042 (Transport Robot) ----
MACHINE_ID=M-042
MACHINE_PRIVATE_KEY=
# Optional overrides (default: derived from MACHINE_PRIVATE_KEY)
MACHINE_WALLET_ADDRESS=
MACHINE_SIGNER_ADDRESS=

# ---- Demo machine 2: M-051 (Robotic Pick-and-Place Color Sorting Arm) ----
MACHINE_051_ID=M-051
MACHINE_051_PRIVATE_KEY=
# Optional overrides (default: derived from MACHINE_051_PRIVATE_KEY)
MACHINE_051_WALLET_ADDRESS=
MACHINE_051_SIGNER_ADDRESS=

# ---- Demo & Pricing parameters ----
# Scaled so demo jobs fit safely within the faucet's 10 MSTC allocation
MIN_STAKE=0
MACHINE_STAKE=0.01
JOB_REWARD=2.2
PRICE_SCALE=0.1
JOB_DURATION_SECONDS=3600
DEMO_JOB_DESCRIPTION=Move package A to green zone
LOCAL_MACHINE_FUND_ETH=10
LOCAL_VERIFIER_FUND_ETH=10

# ---- Frontend Public Environment Variables (VITE_ prefixed only, NO private keys) ----
VITE_NETWORK_MODE=mst
VITE_MST_CHAIN_ID=91562037
VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_EXPLORER_URL=https://testnet.mstscan.com
VITE_PRICE_SCALE=0.1
VITE_MEMBER3_API_URL=http://localhost:4000
