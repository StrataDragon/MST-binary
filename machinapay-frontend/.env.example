# Base URL of Member 3's machine-agent + verifier service.
VITE_MEMBER3_API_URL=http://localhost:4000

# Standalone 3D simulator URL
VITE_SIMULATOR_URL=http://localhost:5174

# Network mode: "mst" for MST Testnet (Chain ID 91562037), "local" for Hardhat node (Chain ID 31337)
VITE_NETWORK_MODE=mst
VITE_MST_CHAIN_ID=91562037
VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_EXPLORER_URL=https://testnet.mstscan.com

# Optional frontend dev server port (default 5173)
VITE_PORT=5173

# Optional comma-separated machine IDs to query/display in the machine panel
VITE_MACHINE_IDS=M-042,M-051

# Job creation form defaults (scaled for ~9.8 tMSTC testnet faucet balances)
VITE_DEFAULT_JOB_DESCRIPTION=Move package A to green zone
VITE_DEFAULT_JOB_REWARD=1.0
VITE_DEFAULT_JOB_MINUTES=60

# --- Privy Embedded Wallet Configuration ---
# Create your app at https://dashboard.privy.io -> Settings -> Basics
# Copy the App ID (format: cl... or similar alphanumeric string)
# Enable Email and Google login, enable Ethereum embedded wallets, and add
# http://localhost:5173 to your Allowed Origins in the Privy dashboard.
VITE_PRIVY_APP_ID=
# Optional Privy Client ID (if configured in dashboard.privy.io -> Settings -> Clients)
VITE_PRIVY_CLIENT_ID=
