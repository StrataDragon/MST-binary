# Base URL of Member 3's machine-agent + verifier service.
VITE_MEMBER3_API_URL=http://localhost:4000

# Optional frontend dev server port (default 5173)
VITE_PORT=5173

# Optional comma-separated machine IDs to query/display in the machine panel
# (Defaults to dynamically querying all registered machines from on-chain MachineRegistry)
VITE_MACHINE_IDS=M-042

# Optional simulation default targets (stands in for Member 2 robot sim)
VITE_DEFAULT_PACKAGE_ID=A
VITE_DEFAULT_TARGET_ZONE=green
VITE_DEFAULT_TARGET_X=9
VITE_DEFAULT_TARGET_Y=4

# Optional job creation form defaults
VITE_DEFAULT_JOB_DESCRIPTION=Move package A to green zone
VITE_DEFAULT_JOB_REWARD=100
VITE_DEFAULT_JOB_MINUTES=60
