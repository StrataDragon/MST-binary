# Copy this file to .env and fill in real values before running on Laptop 2.

# This machine's identity (assigned by Member 1's MachineRegistry contract).
VITE_MACHINE_ID=M-042

# WebSocket URL of the backend / machine agent (Member 3), reachable over the
# LAN from Laptop 2. Replace with Laptop 1's (or the backend host's) actual
# IP address on the shared Wi-Fi / hotspot. Do NOT use localhost unless the
# backend is running on this same machine.
VITE_SIMULATOR_WS_URL=ws://192.168.1.10:3000/ws

# Set to "false" once the real backend is ready. While "true", the simulator
# runs fully offline against a built-in fake backend and shows on-screen
# "SEND TEST JOB" buttons for manual testing.
VITE_MOCK_MODE=true

# How long (ms) the robot shows the completed/failed result before
# automatically returning to IDLE.
VITE_AUTO_RESET_DELAY_MS=6000

# Heartbeat frequency (ms) sent to the backend while online.
VITE_HEARTBEAT_INTERVAL_MS=5000
