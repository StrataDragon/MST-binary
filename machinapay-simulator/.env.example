# Copy this file to .env and fill in real values.

# This machine's identity (assigned by Member 1's MachineRegistry contract).
VITE_MACHINE_ID=M-042

# WebSocket URL of the backend / machine agent (Member 3).
# Default local: ws://localhost:4000/ws
# For cross-laptop setup: ws://<laptop-1-ip>:4000/ws
VITE_SIMULATOR_WS_URL=ws://localhost:4000/ws

# Set to "false" to connect live to the MachinaPay backend service.
# While "true", the simulator runs fully offline against a built-in fake backend.
VITE_MOCK_MODE=false

# How long (ms) the robot shows the completed/failed result before
# automatically returning to IDLE.
VITE_AUTO_RESET_DELAY_MS=6000

# Heartbeat frequency (ms) sent to the backend while online.
VITE_HEARTBEAT_INTERVAL_MS=5000
