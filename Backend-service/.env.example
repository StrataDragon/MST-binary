# --- Server ---
PORT=4000
# SELF_URL is only used to build the default VERIFIER_URL; override if you split
# the machine agent and verifier into two separate processes/servers.
SELF_URL=http://localhost:4000
# VERIFIER_URL=http://localhost:5000/verifier/verify   # uncomment if verifier runs elsewhere

# --- Chain config ---
# Path to the contracts.json Member 1 generates on deploy. Defaults to the copy
# committed in integration/machinapay.contracts.json. Point this at a fresh copy
# whenever Member 1 redeploys (locally or to MST testnet).
# CONTRACTS_JSON=./integration/machinapay.contracts.json
# RPC_URL=https://testnetrpc.mstblockchain.com   # override only if it differs from contracts.json

# --- Machine identity (the virtual robot's wallet + signer key; same key in the demo) ---
MACHINE_ID=M-042
MACHINE_PRIVATE_KEY=0xREPLACE_WITH_THROWAWAY_TESTNET_KEY

# --- Verifier identity ---
# This address MUST equal the `verifier` address baked into JobEscrow at deploy time.
# Give this address to Member 1 BEFORE they deploy, or every attestation reverts.
VERIFIER_PRIVATE_KEY=0xREPLACE_WITH_THROWAWAY_TESTNET_KEY

# --- Demo client simulation targets (optional overrides for scripts/demo-client.ts) ---
# DEMO_PACKAGE_ID=A
# DEMO_TARGET_ZONE=green
# DEMO_TARGET_X=9
# DEMO_TARGET_Y=4
